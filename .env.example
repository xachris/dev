# Django
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Localization
DJANGO_LANGUAGE_CODE=zh-hans
DJANGO_TIME_ZONE=Asia/Shanghai

# PostgreSQL
POSTGRES_DB=school_platform
POSTGRES_USER=school_platform
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email notification adapter (Phase 13 before real mail)
EMAIL_BACKEND=console
EMAIL_FROM_ADDRESS=reports@example.edu

# AI adapter (Phase 16)
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
